#include <iostream>
using namespace std;

int findMissing(int arr[], int size) {
    for (int i = 0; i < size; i++) {
        if (arr[i] != i + 1) {
            return i + 1;
        }
    }
    return size + 1;
}

int main() {
    int numbers[] = {1, 2, 3, 5, 6};
    int size = 5;
    
    cout << "Missing number: " << findMissing(numbers, size);
    return 0;
}
