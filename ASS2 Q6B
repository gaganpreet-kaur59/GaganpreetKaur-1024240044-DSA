#include <iostream>
#include <vector>
using namespace std;

struct Element {
    int row;
    int col;
    int value;
};

int main() {
    vector<Element> matrix1 = {{0, 0, 1}, {1, 1, 2}};
    vector<Element> matrix2 = {{0, 1, 3}, {1, 0, 4}};
    vector<Element> result = matrix1;

    for(Element e2 : matrix2) {
        bool found = false;
        for(Element &e1 : result) {
            if(e1.row == e2.row && e1.col == e2.col) {
                e1.value += e2.value;
                found = true;
                break;
            }
        }
        if(!found) {
            result.push_back(e2);
        }
    }

    cout << "Matrix 1 + Matrix 2:" << endl;
    for(Element e : result) {
        cout << e.row << " " << e.col << " " << e.value << endl;
    }

    return 0;
}
