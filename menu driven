#include <iostream>
using namespace std;

#define MAX 100

class Stack {
    int arr[MAX];
    int top;
public:
    Stack() { top = -1; }

    bool isEmpty() { return top == -1; }
    bool isFull()  { return top == MAX - 1; }

    void push(int x) {
        if (isFull()) {
            cout << "Stack Overflow!\n";
        } else {
            arr[++top] = x;
            cout << x << " pushed.\n";
        }
    }

    void pop() {
        if (isEmpty()) {
            cout << "Stack Underflow!\n";
        } else {
            cout << arr[top--] << " popped.\n";
        }
    }

    int peek() {
        if (isEmpty()) {
            cout << "Stack is empty!\n";
            return -1;
        }
        return arr[top];
    }

    void display() {
        if (isEmpty()) {
            cout << "Stack is empty!\n";
            return;
        }
        cout << "Stack(top->bottom): ";
        for (int i = top; i >= 0; i--) cout << arr[i] << " ";
        cout << "\n";
    }
};

int main() {
    Stack s;
    int ch, val;

    do {
        cout << "\n*** Stack Menu ***\n";
        cout << "1.Push  2.Pop  3.Peek  4.Display  5.isEmpty  6.isFull  0.Exit\n";
        cout << "Enter choice: ";
        cin >> ch;

        switch (ch) {
            case 1: cout << "Value: "; cin >> val; s.push(val); break;
            case 2: s.pop(); break;
            case 3: cout << "Top = " << s.peek() << "\n"; break;
            case 4: s.display(); break;
            case 5: cout << (s.isEmpty() ? "Yes, Empty\n" : "No, not Empty\n"); break;
            case 6: cout << (s.isFull()  ? "Yes, Full\n"  : "No, not Full\n");  break;
            case 0: cout << "Bye!\n"; break;
            default: cout << "Invalid!\n";
        }
    } while (ch != 0);

    return 0;
}
