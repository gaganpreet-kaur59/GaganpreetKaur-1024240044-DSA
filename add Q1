#include <iostream>
using namespace std;

#define MAX 10000

class IntStack {
    int a[MAX];
    int top;
public:
    IntStack() { top = -1; }
    bool empty() { return top == -1; }
    void push(int x) { if (top < MAX - 1) a[++top] = x; }
    int pop() { return empty() ? -1 : a[top--]; }
    int peek() { return empty() ? -1 : a[top]; }
};

int main() {
    int n;
    cout << "Enter n: ";
    cin >> n;
    int *A = new int[n];
    cout << "Enter " << n << " elements: ";
    for (int i = 0; i < n; i++) cin >> A[i];

    IntStack st;
    cout << "Nearest smaller to left: ";
    for (int i = 0; i < n; i++) {
        while (!st.empty() && st.peek() >= A[i]) st.pop();
        if (st.empty()) cout << -1 << " ";
        else cout << st.peek() << " ";
        st.push(A[i]);
    }
    cout << "\n";
    delete[] A;
    return 0;
}
