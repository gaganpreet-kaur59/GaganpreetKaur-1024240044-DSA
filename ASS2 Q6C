#include <iostream>
#include <vector>
using namespace std;

struct Element {
    int row;
    int col;
    int value;
};

int main() {
    vector<Element> matrix1 = {{0, 0, 1}, {1, 1, 2}};
    vector<Element> matrix2 = {{0, 1, 3}, {1, 0, 4}};
    vector<Element> result;

    for(Element e1 : matrix1) {
        for(Element e2 : matrix2) {
            if(e1.col == e2.row) {
                bool found = false;
                for(Element &r : result) {
                    if(r.row == e1.row && r.col == e2.col) {
                        r.value += e1.value * e2.value;
                        found = true;
                        break;
                    }
                }
                if(!found) {
                    result.push_back({e1.row, e2.col, e1.value * e2.value});
                }
            }
        }
    }

    cout << "Matrix 1 * Matrix 2:" << endl;
    for(Element e : result) {
        cout << e.row << " " << e.col << " " << e.value << endl;
    }

    return 0;
}
