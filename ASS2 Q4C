#include <iostream>
#include <string>
using namespace std;

int main() {
    string input = "Education";
    string result = "";
    
    for (char c : input) {
        if (c != 'a' && c != 'e' && c != 'i' && c != 'o' && c != 'u' &&
            c != 'A' && c != 'E' && c != 'I' && c != 'O' && c != 'U') {
            result += c;
        }
    }
    
    cout << result;
    return 0;
}
