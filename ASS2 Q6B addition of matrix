// simple version
#include <iostream>
using namespace std;

int main() {
    int r, c, n1, n2;
    cout << "Enter rows, cols of matrices: ";
    cin >> r >> c;
    cout << "Enter non-zero count of A: ";
    cin >> n1;
    cout << "Enter non-zero count of B: ";
    cin >> n2;

    int A[10][3], B[10][3], C[20][3];
    cout << "Enter A triplet (row col value):\n";
    for (int i = 0; i < n1; i++) cin >> A[i][0] >> A[i][1] >> A[i][2];
    cout << "Enter B triplet (row col value):\n";
    for (int i = 0; i < n2; i++) cin >> B[i][0] >> B[i][1] >> B[i][2];

    int k = 0, i = 0, j = 0;
    while (i < n1 && j < n2) {
        if (A[i][0] == B[j][0] && A[i][1] == B[j][1]) {
            C[k][0] = A[i][0];
            C[k][1] = A[i][1];
            C[k][2] = A[i][2] + B[j][2];
            i++; j++; k++;
        }
        else if (A[i][0] < B[j][0] || (A[i][0]==B[j][0] && A[i][1] < B[j][1])) {
            C[k][0] = A[i][0]; C[k][1] = A[i][1]; C[k][2] = A[i][2];
            i++; k++;
        } else {
            C[k][0] = B[j][0]; C[k][1] = B[j][1]; C[k][2] = B[j][2];
            j++; k++;
        }
    }
    while (i < n1) { C[k][0]=A[i][0]; C[k][1]=A[i][1]; C[k][2]=A[i][2]; i++; k++; }
    while (j < n2) { C[k][0]=B[j][0]; C[k][1]=B[j][1]; C[k][2]=B[j][2]; j++; k++; }

    cout << "Result triplet:\n";
    for (int x = 0; x < k; x++)
        cout << C[x][0] << " " << C[x][1] << " " << C[x][2] << endl;
    return 0;
}
