#include <iostream>
using namespace std;

int main() {
    int size = 3;
    int diag[size];
    
    diag[0] = 1; // Row 1, Column 1
    diag[1] = 5; // Row 2, Column 2
    diag[2] = 9; // Row 3, Column 3
    
    cout << "Diagonal Matrix:" << endl;
    for(int i = 0; i < size; i++) {
        for(int j = 0; j < size; j++) {
            if(i == j) cout << diag[i] << " ";
            else cout << "0 ";
        }
        cout << endl;
    }
    return 0;
}
