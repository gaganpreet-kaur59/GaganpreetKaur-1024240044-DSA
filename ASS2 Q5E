#include <iostream>
using namespace std;

int main() {
    int size = 3;
    int symm[size*(size+1)/2] = {1,2,3,4,5,6};
    
    cout << "Symmetric Matrix:" << endl;
    for(int i = 0; i < size; i++) {
        for(int j = 0; j < size; j++) {
            if(i >= j) {
                cout << symm[i*(i+1)/2 + j] << " ";
            } else {
                cout << symm[j*(j+1)/2 + i] << " ";
            }
        }
        cout << endl;
    }
    return 0;
}
