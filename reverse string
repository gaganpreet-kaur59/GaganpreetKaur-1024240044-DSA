// reverse_string
#include <iostream>
using namespace std;

#define MAX 200

class CharStack {
    char a[MAX];
    int top;
public:
    CharStack() { top = -1; }
    bool isEmpty() { return top == -1; }
    bool isFull()  { return top == MAX - 1; }

    void push(char c) {
        if (isFull()) cout << "Overflow!\n";
        else a[++top] = c;
    }

    char pop() {
        if (isEmpty()) { cout << "Underflow!\n"; return '\0'; }
        return a[top--];
    }
};

int main() {
    string s;
    cout << "Enter string (no spaces): ";
    cin >> s;

    CharStack st;
    for (char c : s) st.push(c);

    cout << "Reversed: ";
    while (!st.isEmpty()) cout << st.pop();
    cout << "\n";
    return 0;
}
