#include <iostream>
#include <cctype>
using namespace std;

#define MAX 500

class CharStack {
    char a[MAX];
    int top;
public:
    CharStack() { top = -1; }
    bool empty() { return top == -1; }
    char peek() { return empty() ? '\0' : a[top]; }
    void push(char c) { if (top < MAX - 1) a[++top] = c; }
    char pop() { return empty() ? '\0' : a[top--]; }
};

int prec(char op) {
    if (op == '^') return 3;
    if (op == '*' || op == '/') return 2;
    if (op == '+' || op == '-') return 1;
    return 0;
}

bool isRightAssoc(char op) { return op == '^'; }

string infixToPostfix(const string &in) {
    CharStack st;
    string out = "";
    for (char ch : in) {
        if (isalnum((unsigned char)ch)) {
            out += ch;
        } else if (ch == '(') {
            st.push(ch);
        } else if (ch == ')') {
            while (!st.empty() && st.peek() != '(') out += st.pop();
            if (!st.empty()) st.pop(); // pop '('
        } else { // operator
            while (!st.empty() && st.peek() != '(' &&
                  (prec(st.peek()) > prec(ch) ||
                  (prec(st.peek()) == prec(ch) && !isRightAssoc(ch)))) {
                out += st.pop();
            }
            st.push(ch);
        }
    }
    while (!st.empty()) out += st.pop();
    return out;
}

int main() {
    string inf;
    cout << "Enter infix (no spaces): ";
    cin >> inf;
    cout << "Postfix: " << infixToPostfix(inf) << "\n";
    return 0;
}

