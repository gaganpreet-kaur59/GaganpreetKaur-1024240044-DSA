#include <iostream>
using namespace std;

int main() {
    int n;
    cout << "Enter size of upper triangular matrix: ";
    cin >> n;

    int upper[n][n];

    cout << "Enter elements of upper triangle (row-wise):" << endl;
    for (int i = 0; i < n; i++) {
        for (int j = i; j < n; j++) {   // only upper part
            cin >> upper[i][j];
        }
    }

    cout << "Upper Triangular Matrix:" << endl;
    for (int i = 0; i < n; i++) {
        for (int j = 0; j < n; j++) {
            if (j >= i)
                cout << upper[i][j] << " ";
            else
                cout << "0 ";
        }
        cout << endl;
    }

    return 0;
}
