#include <iostream>
using namespace std;

int main() {
    int size = 3;
    int tri[3*size-2] = {1,2,3,4,5,6,7};
    
    cout << "Tri-diagonal Matrix:" << endl;
    for(int i = 0; i < size; i++) {
        for(int j = 0; j < size; j++) {
            if(abs(i-j) <= 1) {
                cout << tri[2*i+j] << " ";
            } else {
                cout << "0 ";
            }
        }
        cout << endl;
    }
    return 0;
}
