#include <iostream>
using namespace std;

int main() {
    int size = 3;
    int lower[size*(size+1)/2] = {1,2,3,4,5,6};
    
    cout << "Lower Triangular Matrix:" << endl;
    for(int i = 0; i < size; i++) {
        for(int j = 0; j < size; j++) {
            if(i >= j) {
                cout << lower[i*(i+1)/2 + j] << " ";
            } else {
                cout << "0 ";
            }
        }
        cout << endl;
    }
    return 0;
}
