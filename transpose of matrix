#include <iostream>
using namespace std;

int main() {
    int r, c, n;
    cout << "Enter rows, cols and non-zero elements: ";
    cin >> r >> c >> n;

    int triplet[10][3], trans[10][3];
    cout << "Enter triplet (row col value):\n";
    for (int i = 0; i < n; i++) {
        cin >> triplet[i][0] >> triplet[i][1] >> triplet[i][2];
    }

    // transpose → swap row and col
    for (int i = 0; i < n; i++) {
        trans[i][0] = triplet[i][1];
        trans[i][1] = triplet[i][0];
        trans[i][2] = triplet[i][2];
    }

    cout << "Transpose triplet:\n";
    for (int i = 0; i < n; i++) {
        cout << trans[i][0] << " " << trans[i][1] << " " << trans[i][2] << endl;
    }
    return 0;
}
